<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tl_teleop_f710</name>
  <version>1.0.0</version>
  <description>天链机械臂 Logitech F710 手柄遥操作功能包

    通过 Logitech F710 游戏手柄远程控制天链机械臂运动。
    基于笛卡尔空间伺服（servol）实现直观的末端位置控制。
    支持 6 轴和 7 轴机械臂型号。
  </description>
  <maintainer email="example@mail.com">root</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>joy</depend>
  <depend>tl_ros2_interface</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
