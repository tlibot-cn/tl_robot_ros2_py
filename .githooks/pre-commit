#!/usr/bin/env bash
#
# pre-commit hook — Python 代码自动格式化
# 提交前自动格式化暂存区中的 Python 文件，并重新暂存
#
# 工具: black（格式化）
# 跳过: git commit --no-verify 或 -n
#
set -euo pipefail

readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

# ── 收集暂存区的 Python 文件 ────────────────────
PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)

if [ -z "$PY_FILES" ]; then
    echo -e "${GREEN}[pre-commit] 没有暂存的 Python 文件，跳过${NC}"
    exit 0
fi

echo -e "${YELLOW}[pre-commit] 检查 Python 代码格式...${NC}"

formatted=false
while IFS= read -r f; do
    [ ! -f "$f" ] && continue

    # black — 代码格式化
    black --quiet "$f" 2>/dev/null || true

    if ! git diff --quiet "$f"; then
        formatted=true
        echo -e "  ${YELLOW}已格式化: $f${NC}"
        git add "$f"
    fi
done <<< "$PY_FILES"

if [ "$formatted" = true ]; then
    echo -e "${GREEN}[pre-commit] Python 代码已自动格式化并重新暂存${NC}"
else
    echo -e "${GREEN}[pre-commit] 所有 Python 文件格式正确${NC}"
fi

exit 0
